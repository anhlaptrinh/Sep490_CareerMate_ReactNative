# API Configuration Example
# Copy this file to .env and .env.development and update with your values

# Backend API URL
# For iOS Simulator or web browser:
# API_URL="http://localhost:8080/api"

# For Android Emulator:
# API_URL="http://10.0.2.2:8080/api"

# For Physical Device (replace with your computer's IP):
# API_URL="http://192.168.1.3:8080/api"

# Or use ngrok for external access:
# API_URL="https://your-ngrok-url.ngrok.io/api"

API_URL="http://localhost:8080/api"

# Application Environment
APP_ENV=development
